#include <winver.h>

#define VER_MAJOR 1
#define VER_MINOR 0
#define VER_PATCH 1
#define VER_BUILD 0
#define VER_STRING "1.0.1.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "navossoc"
            VALUE "FileDescription",  "QOI thumbnail provider and preview handler"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "QoiShellExt"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Rafael Cossovan de França (navossoc). MIT License."
            VALUE "OriginalFilename", "QoiShellExt.dll"
            VALUE "ProductName",      "QOI Shell Extensions"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
